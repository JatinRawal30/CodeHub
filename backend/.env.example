# Copy to backend/.env and fill in real values
PORT=3200
DB_URI=mongodb+srv://<user>:<password>@<cluster>/<db>
JWT_KEY=<long-random-string>
REFRESH_KEY=<different-long-random-string>
REDIS_KEY=<redis-cloud-password>
REDIS_HOST=<redis-cloud-host>
REDIS_PORT=<redis-cloud-port>

# Optional: real email delivery for OTPs (otherwise the code is printed to the server console)
# brevo (default) or resend
EMAIL_PROVIDER=brevo
# Brevo: Settings -> SMTP & API -> API Keys
BREVO_API_KEY=
# Resend: only needed when EMAIL_PROVIDER=resend; needs a verified domain to reach real users
RESEND_EMAIL_KEY=
# Brevo: an address verified under Senders, e.g. CodeHub <you@gmail.com>
# Resend: an address on your verified domain (defaults to onboarding@resend.dev for testing)
EMAIL_FROM=

# Optional: Cloudinary credentials for image uploads
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=